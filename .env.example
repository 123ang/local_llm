# AskAI Configuration

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://askai_app:REPLACE_ME@localhost:5432/askai
DATABASE_URL_SYNC=postgresql+psycopg2://askai_app:REPLACE_ME@localhost:5432/askai
TEXT_TO_SQL_DATABASE_URL=postgresql+asyncpg://askai_text_reader:REPLACE_ME@localhost:5432/askai
TEXT_TO_SQL_DB_ROLE=askai_text_reader
DATASET_IMPORT_DB_ROLE=askai_dataset_importer

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
SECRET_KEY=replace-with-at-least-32-random-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=gemma4:latest
# Code-specialized model for SQL generation (fast, accurate at structured queries)
LLM_MODEL_FAST=qwen2.5-coder:1.5b
EMBEDDING_MODEL=nomic-embed-text

# ChromaDB
CHROMA_PERSIST_DIR=./storage/chromadb

# File Storage
UPLOAD_DIR=./storage/uploads
MAX_SQL_UPLOAD_BYTES=10485760
MAX_SQL_IMPORT_TABLES=25
MAX_SQL_IMPORT_COLUMNS_PER_TABLE=200
MAX_SQL_IMPORT_ROWS=100000

# CORS
FRONTEND_URL=http://localhost:3000
# Optional: comma-separated, e.g. https://www.andai.my
# CORS_EXTRA_ORIGINS=
# Set true only when the app is behind a trusted reverse proxy that sets X-Forwarded-For
TRUST_PROXY_HEADERS=false

# Super Admin (created on first run)
SUPER_ADMIN_EMAIL=admin@askai.local
SUPER_ADMIN_PASSWORD=replace-with-strong-initial-password
